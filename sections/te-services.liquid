{%- liquid
  assign bg_class = 'te-ds--navy'
  if section.settings.bg_variant == 'navy-mid'
    assign bg_class = 'te-ds--navy-mid'
  elsif section.settings.bg_variant == 'navy-card'
    assign bg_class = 'te-ds--navy-card'
  endif
-%}
<div class="te-dienst-section {{ bg_class }}" id="{{ section.settings.section_id }}">
  <div class="te-dienst-inner te-wrap">
    <div class="te-ds-label te-reveal">
      <div class="te-chip">{{ section.settings.chip_label }}</div>
      <h3>{{ section.settings.heading }}</h3>
      <p>{{ section.settings.description }}</p>
      {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
        <a href="{{ section.settings.link_url }}">{{ section.settings.link_text }} &#8594;</a>
      {%- endif -%}
    </div>
    <div class="te-ds-cards">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.card_url }}" class="te-ds-card te-reveal" {{ block.shopify_attributes }}>
          <div class="te-ds-card-icon">
            {%- if block.settings.icon_type == 'shopify' -%}
              <span class="te-brand-chip te-brand-chip--shopify" aria-hidden="true">
                <svg viewBox="0 0 640 640" width="20" height="20" focusable="false"><path d="M484.5 168.1C484.3 167 483.8 166 483 165.3C482.2 164.6 481.2 164.1 480.1 164.1C478.1 164.1 442.9 163.3 442.9 163.3C442.9 163.3 421.3 142.5 413.3 134.5L413.3 567.2L539 536C539 536 485 170.5 484.6 168.1zM384.9 134.5C383 128.4 380.6 122.6 377.7 116.9C367.3 96.9 351.7 86 333.3 86C332 86 330.6 86.1 329.3 86.4C328.9 85.6 328.1 85.2 327.7 84.4C319.7 75.6 309.3 71.6 296.9 72C272.9 72.8 248.9 90 229.7 120.8C216.1 142.4 205.7 169.6 202.9 190.9C175.3 199.3 156.1 205.3 155.7 205.7C141.7 210.1 141.3 210.5 139.7 223.7C138.5 233.7 101.7 515.5 101.7 515.5L404.3 568L404.3 129.7C394.3 131.7 385.1 134.5 384.9 134.5zM329.6 151.7C313.6 156.5 296 162.1 278.8 167.3C283.6 148.5 293.2 129.7 304.4 117.3C308.8 112.9 314.8 107.7 321.6 104.5C328.4 118.9 330 138.5 329.6 151.7zM296.8 88.4C301.8 88.2 306.8 89.5 311.2 92C304.8 95.2 298.4 100.4 292.4 106.4C277.2 122.8 265.6 148.4 260.8 172.9C246.4 177.3 232 181.7 218.8 185.7C227.6 147.3 260 89.3 296.8 88.5zM250.4 308.6C252 334.2 319.6 339.8 323.6 400.3C326.4 447.9 298.4 480.4 258 482.8C209.2 486 182.4 457.2 182.4 457.2L192.8 413.2C192.8 413.2 219.6 433.6 241.2 432C255.2 431.2 260.4 419.6 260 411.6C258 378 202.8 380 199.2 324.7C196 278.3 226.4 231.4 293.7 227C319.7 225.4 332.9 231.8 332.9 231.8L317.7 289.4C317.7 289.4 300.5 281.4 280.1 283C250.5 285 250.1 303.8 250.5 308.6zM345.6 146.9C345.6 134.9 344 117.7 338.4 103.3C356.8 106.9 365.6 127.3 369.6 139.7C362.4 141.7 354.4 144.1 345.6 146.9z"/></svg>
              </span>
            {%- elsif block.settings.icon_type == 'lightspeed' -%}
              <span class="te-brand-chip te-brand-chip--lightspeed" aria-hidden="true">
                <svg viewBox="0 0 72.75 108.5" width="14" height="20" focusable="false"><path d="m36.37 0 5 8.7a6 6 0 0 1 0 5.8l-29.8 51.7 14.1 24.4a12.34 12.34 0 0 0 21.4 0l14.1-24.4-3.7-6.6-16 27.7a5.8 5.8 0 0 1-5 2.9 5.66 5.66 0 0 1-5-2.9l-12.3-21.1 27.7-48 5 8.7a6 6 0 0 1 0 5.8l-19.3 33.5 3.8 6.6 21-36.4 13.8 23.9a12 12 0 0 1 0 11.9l-14 24.3a24.21 24.21 0 0 1-20.8 12c-12 0-18.6-8.3-20.8-12l-14-24.3a12.08 12.08 0 0 1 0-11.9Z"/></svg>
              </span>
            {%- endif -%}
          </div>
          <div class="te-ds-card-body">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.description }}</p>
          </div>
          <span class="te-ds-card-arrow" aria-hidden="true">&#8594;</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
.te-dienst-section {
  border-bottom: 1px solid var(--te-border);
  position: relative;
  z-index: 1;
}
.te-ds--navy      { background: var(--te-navy); }
.te-ds--navy-mid  { background: var(--te-navy-mid); }
.te-ds--navy-card { background: var(--te-navy-card); }
.te-dienst-inner {
  padding: clamp(40px,6vw,80px) var(--te-px);
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
}
@media(min-width:768px) {
  .te-dienst-inner { grid-template-columns: 260px 1fr; gap: 48px; align-items: start; }
}
.te-ds-label .te-chip { margin-bottom: 10px; }
.te-ds-label h3 {
  font-family: var(--te-display);
  font-size: clamp(18px,2.5vw,24px);
  font-weight: 700;
  color: var(--te-text);
  letter-spacing: -.01em;
  margin-bottom: 10px;
}
.te-ds-label p {
  font-family: var(--te-body);
  font-size: 14px;
  color: var(--te-muted);
  line-height: 1.7;
  margin-bottom: 16px;
}
.te-ds-label a {
  font-family: var(--te-body);
  font-size: 13px;
  font-weight: 700;
  color: var(--te-orange);
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: gap .2s;
  text-decoration: none;
}
.te-ds-label a:hover { gap: 10px; }
.te-ds-cards {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.te-ds-card {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  background: var(--te-navy-card);
  border: 1px solid var(--te-border);
  border-radius: 10px;
  padding: 16px 20px;
  transition: border-color .2s, background .2s, transform .2s, box-shadow .2s;
  text-decoration: none;
  color: inherit;
}
.te-ds-card:hover {
  border-color: var(--te-orange-bd);
  background: var(--te-navy-lt);
  transform: translateY(-2px);
  box-shadow: var(--te-shadow-md);
}
.te-ds-card-icon {
  flex-shrink: 0;
  margin-top: 2px;
}
.te-brand-chip--shopify svg { fill: #95BF47; }
.te-brand-chip--lightspeed svg { fill: #e81c1c; }
.te-ds-card-body { flex: 1; }
.te-ds-card-body h4 {
  font-family: var(--te-body);
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 3px;
  color: var(--te-text);
}
.te-ds-card-body p {
  font-family: var(--te-body);
  font-size: 13px;
  color: var(--te-muted);
  line-height: 1.55;
}
.te-ds-card-arrow {
  margin-left: auto;
  font-size: 14px;
  color: var(--te-orange);
  flex-shrink: 0;
  align-self: center;
  transition: transform .2s;
}
.te-ds-card:hover .te-ds-card-arrow { transform: translateX(4px); }
{% endstylesheet %}

{% schema %}
{
  "name": "TE Services",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Sectie anker-ID",
      "default": "diensten"
    },
    {
      "type": "select",
      "id": "bg_variant",
      "label": "Achtergrond",
      "options": [
        { "value": "navy", "label": "Donkerblauw (navy)" },
        { "value": "navy-mid", "label": "Middenblauw (navy-mid)" },
        { "value": "navy-card", "label": "Card blauw (navy-card)" }
      ],
      "default": "navy"
    },
    {
      "type": "text",
      "id": "chip_label",
      "label": "Chip label",
      "default": "Shopify"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shopify webshops & oplossingen"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Omschrijving",
      "default": "Van een gloednieuwe shop tot slimme kassaintegatie — we kennen Shopify door en door en helpen je er alles uit te halen."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link tekst",
      "default": "Alles over Shopify"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Service kaart",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icoon type",
          "options": [
            { "value": "none", "label": "Geen" },
            { "value": "shopify", "label": "Shopify" },
            { "value": "lightspeed", "label": "Lightspeed" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Service naam"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Omschrijving",
          "default": "Korte omschrijving van de service."
        },
        {
          "type": "url",
          "id": "card_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TE Services"
    }
  ]
}
{% endschema %}
