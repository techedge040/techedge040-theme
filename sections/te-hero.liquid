{% stylesheet %}
.te-hero-section {
  background: linear-gradient(160deg, #162444 0%, #0C1628 100%);
  position: relative;
  overflow: hidden;
}
.te-hero-glow {
  position: absolute;
  top: -80px;
  right: -100px;
  width: min(600px, 100vw);
  height: min(600px, 100vw);
  background: radial-gradient(circle, rgba(217,94,27,.18) 0%, transparent 65%);
  pointer-events: none;
  animation: te-hero-glow 8s ease-in-out infinite;
}
@keyframes te-hero-glow { 0%,100%{transform:scale(1);}50%{transform:scale(1.1);} }
.te-hero-inner {
  padding: clamp(56px,8vw,100px) var(--te-px);
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
  position: relative;
  z-index: 1;
}
@media(min-width:900px) {
  .te-hero-inner { grid-template-columns: 1fr 400px; align-items: center; }
}
.te-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.14);
  color: rgba(240,237,232,.60);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 7px 16px;
  border-radius: 100px;
  margin-bottom: 22px;
}
.te-hero-badge::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--te-orange);
  animation: te-blink 2s infinite;
}
.te-hero-text h1 {
  font-family: var(--te-display);
  font-size: clamp(34px, 6vw, 68px);
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: -.02em;
  color: var(--te-text);
  margin-bottom: 20px;
}
.te-hero-text h1 em {
  font-style: italic;
  color: var(--te-orange);
}
.te-hero-lead {
  font-family: var(--te-body);
  font-size: clamp(16px, 2vw, 19px);
  color: var(--te-muted);
  line-height: 1.8;
  margin-bottom: 32px;
}
.te-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}
/* Hero card */
.te-hero-card {
  background: rgba(255,255,255,.05);
  border: 1px solid var(--te-border-lt);
  border-radius: 16px;
  padding: 28px;
  position: relative;
  overflow: hidden;
  font-family: var(--te-body);
}
.te-hero-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--te-orange), transparent);
}
.te-hc-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--te-orange);
  margin-bottom: 18px;
}
.te-stack-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 0;
  border-bottom: 1px solid var(--te-border);
  font-size: 14px;
  font-weight: 600;
  color: var(--te-text);
}
.te-stack-row--last { border-bottom: none; }
.te-stack-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 20px;
}
.te-hc-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 18px;
}
.te-stat {
  background: var(--te-orange-bg);
  border: 1px solid var(--te-orange-bd);
  border-radius: 10px;
  padding: 14px;
  text-align: center;
}
.te-stat-n {
  font-family: var(--te-display);
  font-weight: 900;
  font-size: 28px;
  color: var(--te-orange);
  line-height: 1;
}
.te-stat-l {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .8px;
  text-transform: uppercase;
  color: var(--te-faint);
  margin-top: 4px;
}
{% endstylesheet %}

<script>
(function() {
  const els = document.querySelectorAll('.te-reveal');
  if (window.Shopify && window.Shopify.designMode) {
    els.forEach(function(el) { el.classList.add('te-in'); });
    return;
  }
  if (!('IntersectionObserver' in window)) {
    els.forEach(function(el) { el.classList.add('te-in'); });
    return;
  }
  const io = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry, i) {
      if (entry.isIntersecting) {
        setTimeout(function() {
          entry.target.classList.add('te-in');
        }, i * 75);
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08 });
  els.forEach(function(el) { io.observe(el); });
})();
</script>

