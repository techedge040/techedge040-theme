{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-section-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-hero-bg-shape-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ block.settings.shape_gradient }};
    opacity: {{ block.settings.shape_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 0;
  }

  .ai-hero-inner-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.gap }}px;
  }

  @media (min-width: 750px) {
    .ai-hero-inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }

  .ai-hero-text-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
  }

  .ai-hero-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 500;
    width: fit-content;
  }

  .ai-hero-heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
    font-weight: 700;
  }

  .ai-hero-lead-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-hero-actions-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.button_gap }}px;
  }

  .ai-hero-btn-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 2px solid transparent;
  }

  .ai-hero-btn-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.primary_button_bg }};
    color: {{ block.settings.primary_button_text_color }};
    border-color: {{ block.settings.primary_button_bg }};
  }

  .ai-hero-btn-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.primary_button_hover_bg }};
    border-color: {{ block.settings.primary_button_hover_bg }};
  }

  .ai-hero-btn-outline-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.outline_button_text }};
    border-color: {{ block.settings.outline_button_border }};
  }

  .ai-hero-btn-outline-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.outline_button_hover_bg }};
    color: {{ block.settings.outline_button_hover_text }};
    border-color: {{ block.settings.outline_button_hover_border }};
  }

  .ai-hero-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-hero-card-label-{{ ai_gen_id }} {
    color: {{ block.settings.card_label_color }};
    font-size: {{ block.settings.card_label_size }}px;
    font-weight: 500;
    margin-bottom: {{ block.settings.card_label_margin }}px;
    font-family: monospace;
  }

  .ai-hero-stack-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    padding: {{ block.settings.stack_row_padding }}px 0;
    color: {{ block.settings.stack_row_text_color }};
    font-size: {{ block.settings.stack_row_font_size }}px;
    border-bottom: 1px solid {{ block.settings.stack_row_border_color }};
  }

  .ai-hero-stack-row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-hero-stack-icon-{{ ai_gen_id }} {
    display: inline-flex;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 749px) {
    .ai-hero-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_top }}px {{ block.settings.mobile_padding_horizontal }}px {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-hero-lead-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-hero-actions-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-hero-btn-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-hero-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
