    </div>
  {%- endif -%}
  <h3 class="te-ds-title">{{ block.settings.title }}</h3>
  <p class="te-ds-desc">{{ block.settings.description }}</p>
  <span class="te-ds-arrow" aria-hidden="true">→</span>
</a>

{% stylesheet %}
.te-ds-card {
  display: flex;
  flex-direction: column;
  background: rgba(255,255,255,.04);
  border: 1px solid var(--te-border);
  border-radius: 14px;
  padding: 24px;
  text-decoration: none;
  transition: transform .2s, border-color .2s, background .2s;
  cursor: pointer;
}
.te-ds-card:hover {
  transform: translateY(-2px);
  border-color: var(--te-orange-bd);
  background: var(--te-orange-bg);
}
.te-ds-icon {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
}
.te-ds-title {
  font-family: var(--te-display);
  font-size: 17px;
  font-weight: 700;
  color: var(--te-text);
  margin-bottom: 8px;
  letter-spacing: -.01em;
}
.te-ds-desc {
  font-family: var(--te-body);
  font-size: 14px;
  color: var(--te-muted);
  line-height: 1.7;
  flex-grow: 1;
  margin-bottom: 14px;
}
.te-ds-arrow {
  font-size: 18px;
  color: var(--te-orange);
  transition: transform .2s;
  align-self: flex-start;
}
.te-ds-card:hover .te-ds-arrow { transform: translateX(4px); }
{% endstylesheet %}

{% schema %}
{
  "name": "TE Dienst kaart",
  "tag": null,
  "settings": [
    { "type": "select", "id": "icon_type", "label": "Platform icoon", "options": [
      {"value":"none","label":"Geen"},
      {"value":"shopify","label":"Shopify"},
      {"value":"lightspeed","label":"Lightspeed"}
    ], "default": "none" },
    { "type": "text", "id": "title", "label": "Titel", "default": "Dienst naam" },
    { "type": "textarea", "id": "description", "label": "Omschrijving", "default": "Korte omschrijving van de dienst." },
    { "type": "text", "id": "card_url", "label": "Link URL", "default": "/pages/contact" },
    { "type": "header", "content": "Afstand" },
    { "type": "range", "id": "padding_top", "label": "Ruimte boven", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Ruimte onder", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 }
  ]
}
{% endschema %}
