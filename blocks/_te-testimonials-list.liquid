{%- capture children -%}
  {%- content_for 'blocks' -%}
{%- endcapture -%}

<div
  class="te-testimonials-list"
  style="--te-testimonials-columns: {{ section.settings.columns | default: 3 }};"
  {{ block.shopify_attributes }}
>
  {{ children }}
</div>

{% stylesheet %}
  .te-testimonials-list {
    display: grid;
    grid-template-columns: repeat(var(--te-testimonials-columns, 3), 1fr);
    gap: 24px;
    align-items: start;
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .te-testimonials-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 480px) {
    .te-testimonials-list {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials list",
  "tag": null,
  "blocks": [
    { "type": "group" },
    { "type": "@theme" }
  ]
}
{% endschema %}
